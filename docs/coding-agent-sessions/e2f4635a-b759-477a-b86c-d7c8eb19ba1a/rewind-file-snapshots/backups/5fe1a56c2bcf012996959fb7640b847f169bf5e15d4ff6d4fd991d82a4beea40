ALTER TABLE [dbo].[NotificationDelivery]
ADD CONSTRAINT FK_NotificationDelivery_Payment FOREIGN KEY (PaymentId) REFERENCES [dbo].[Payment](Id);

CREATE UNIQUE INDEX UX_NotificationDelivery_NotificationId ON [dbo].[NotificationDelivery](NotificationId);
