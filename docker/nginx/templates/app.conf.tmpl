upstream acme_app {
    keepalive 32;
    server {{ default "acme-web" (getenv "APP_UPSTREAM_HOST") }}:{{ default "8080" (getenv "APP_UPSTREAM_PORT") }};
}

server {
    listen 80;
    server_name _;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ default "payments.local" (getenv "APP_HOSTNAME") }};

    ssl_certificate {{ getenv "CF_ORIGIN_CERT_PATH" }};
    ssl_certificate_key {{ getenv "CF_ORIGIN_KEY_PATH" }};
    ssl_trusted_certificate {{ getenv "CF_ORIGIN_CA_PATH" }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_prefer_server_ciphers off;

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://acme_app;
    }
}
